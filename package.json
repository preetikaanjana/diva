{
  "name": "sheknows",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run server\" \"npm run client\"",
    "start": "cd client && npm start",
    "build": "cd client && npm run build",
    "build:app": "cd client && npm ci && npm run build",
    "start:prod": "cross-env NODE_ENV=production node server/index.js",
    "test": "cd client && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3"
  }
}
